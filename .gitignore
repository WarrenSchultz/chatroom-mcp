# Secrets & local state — never commit these
tokens/
.env
docker-compose.override.yml
# The DB itself is local state, but the directory must exist at clone time: Docker
# creates a missing bind-mount source as root, which the non-root container user then
# cannot write. Shipping the empty dir means it is owned by whoever cloned instead.
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
.ruff_cache/
.venv/
