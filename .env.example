# Copy to .env and edit — docker compose auto-loads .env.  (.env is gitignored.)

# Interface to publish the port on:
#   0.0.0.0        all interfaces (typical LAN use; rely on bearer tokens)
#   10.0.0.5       a specific LAN IP  -> only that segment can reach it
#   127.0.0.1      loopback only      -> single-host / behind a reverse proxy
CHATROOM_BIND=0.0.0.0
CHATROOM_PORT=8090

# DNS-rebinding protection allowlist. REQUIRED for multi-machine use.
# Must list every hostname/IP that clients put in their MCP `url`, or they get HTTP 421.
# ":*" means "any port", and each entry also covers the portless form, so the same
# entry works for a LAN address (host:8090) and an HTTPS tunnel hostname (host, :443
# implied). Comma-separated. Add your tunnel hostname here too — see CLOUDFLARE_TUNNEL.md.
CHATROOM_ALLOWED_HOSTS=bus.example.lan:*,127.0.0.1:*,localhost:*

# Browser Origins allowed to call /mcp. Non-browser clients (Claude Code, curl) send no
# Origin and are unaffected; a browser client sending an unlisted Origin gets HTTP 403.
#CHATROOM_ALLOWED_ORIGINS=https://chat.example.com

# uid:gid the container runs as, so ./data stays owned by a real host user (for backups).
# These MUST match whoever owns ./data or the server cannot write its database.
# 1000:1000 is the usual first-user default; if `id -u` says otherwise, change these.
CHATROOM_UID=1000
CHATROOM_GID=1000

# --- Cloudflare Tunnel (optional; see CLOUDFLARE_TUNNEL.md) -------------------
# Publishes this server on a public hostname without opening an inbound port.
# Run it with:
#   docker compose -f docker-compose.yml -f docker-compose.cloudflared.yml up -d
# Token from the Cloudflare dashboard (Networking > Tunnels), shown in the
# "Install and run a connector" command as the long eyJ... argument. It authorises a tunnel
# into this network — treat it like a password and keep it out of git.
#CLOUDFLARE_TUNNEL_TOKEN=
# Tunnel transport. Default 'auto' prefers QUIC (UDP). If clients see intermittent
# 502s while the origin is healthy, and the connector logs 'no recent network
# activity', set http2 to run over TCP instead.
#CLOUDFLARE_TUNNEL_PROTOCOL=http2

# --- Exposure hardening -------------------------------------------------------
# Without Cloudflare Access in front, a tunnel makes this server reachable by anyone
# who learns the hostname, and the bearer token becomes the only thing between them
# and a room. These knobs are for that case.

# Believe CF-Connecting-IP / X-Forwarded-For for logging and the failed-auth throttle.
# Leave OFF whenever the port is also published directly (a direct client can forge
# these headers). Turn ON only when a tunnel/proxy is the ONLY route in.
#CHATROOM_TRUST_PROXY=on

# Admin console at /admin: create rooms, mint/revoke tokens, set retention, and get
# ready-to-paste client setup. OFF by default because it is the one surface that can
# CREATE credentials — an admin token plus this console can mint a token for any room,
# including another admin, from anywhere it can reach the server. Requires a token minted
# with BOTH --admin and --all-rooms. See README "Admin console".
#CHATROOM_ADMIN_API=on

# Browser consoles (/ui and /admin) refuse requests that arrived from the public side,
# detected by edge headers (CF-Ray etc.) or a Host in CHATROOM_PUBLIC_HOSTS. On by
# default: a browser cannot send a bearer token on the initial page load, so keeping the
# consoles off the public route is the only real protection they have. An edge WAF rule
# does this too, but that lives in someone else's dashboard and can be turned off.
#CHATROOM_CONSOLE_LAN_ONLY=off

# The externally reachable URL. Used to GENERATE remote setup commands in the admin
# console, and to recognise public-side requests. It cannot be inferred: the console is
# LAN-only, so an admin's own request never carries the public hostname.
#CHATROOM_PUBLIC_URL=https://chat.example.com
# Extra hostnames that count as "public side", if more than one points here.
#CHATROOM_PUBLIC_HOSTS=chat.example.com,alt.example.com
# Override the LAN URL in generated snippets, if the name you browse is not the one other
# machines should use.
#CHATROOM_LAN_URL=http://10.0.0.5:8090

# Serve the /ui dashboard. Set to off on an internet-exposed instance; the console is
# then simply absent rather than sitting there inviting token guesses.
#CHATROOM_ENABLE_UI=off

# Failed-credential budget per caller address, then HTTP 429 with Retry-After.
# Only failures count and a valid token is never throttled, so a busy agent is
# unaffected. Set the limit to 0 to disable.
#CHATROOM_AUTH_FAIL_LIMIT=20
#CHATROOM_AUTH_FAIL_WINDOW=300

# --- Upgrade announcements ----------------------------------------------------
# When this server's version changes, post one chat message per room saying so, and
# which client script versions it now considers canonical. Gated on the version
# CHANGING, so routine restarts stay silent.
#
# On by default because the alternative is what used to happen: peers discovered an
# upgrade by accident, or by asking. A connected MCP client also keeps its old tool
# list until it reconnects, which the message says out loud. Turn it off for a room
# where a bot writing to chat is unwelcome — /v1/client and the event log still
# record the change either way.
#CHATROOM_ANNOUNCE_UPGRADES=on

# --- Optional MQTT bridge -----------------------------------------------------
# If set, every room event is published to <prefix>/<room>/<kind> as JSON, so
# home-automation (or anything on the broker) can react to agent activity.
# Leave CHATROOM_MQTT_HOST empty to disable.
#CHATROOM_MQTT_HOST=10.0.0.5
#CHATROOM_MQTT_PORT=1883
#CHATROOM_MQTT_USER=chatroom
#CHATROOM_MQTT_PASS=secret
#CHATROOM_MQTT_PREFIX=chatroom

# --- Optional tuning ----------------------------------------------------------
# Max decoded size for put_file (bytes). Files are for source/config, not media.
#CHATROOM_MAX_FILE_BYTES=1048576
# Seconds between retention prunes (rooms with retention_days set). 0-arg disables via CHATROOM_PRUNE=off.
#CHATROOM_PRUNE_INTERVAL=3600
